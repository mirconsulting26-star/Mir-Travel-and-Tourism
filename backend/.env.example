# Application Environment
APP_ENV=development
DEBUG=True

# Application & JWT Secrets
SECRET_KEY=DUMMY_SECRET_KEY_CHANGE_IN_PROD_12345
JWT_SECRET=DUMMY_JWT_SECRET_CHANGE_IN_PROD_67890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mir_travel_db

# CORS & Frontend URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_EMAIL=admin@mirtravel.es
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123!

# Provider API Credentials (Optional — Mock Mode Active if Left Dummy)
AMADEUS_CLIENT_ID=DUMMY_AMADEUS_CLIENT_ID
AMADEUS_CLIENT_SECRET=DUMMY_AMADEUS_CLIENT_SECRET
AMADEUS_BASE_URL=https://test.api.amadeus.com

STRIPE_SECRET_KEY=DUMMY_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=DUMMY_STRIPE_WEBHOOK_SECRET

PAYPAL_CLIENT_ID=DUMMY_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=DUMMY_PAYPAL_CLIENT_SECRET

CLOUDINARY_CLOUD_NAME=DUMMY_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=DUMMY_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=DUMMY_CLOUDINARY_API_SECRET

PEXELS_API_KEY=DUMMY_PEXELS_API_KEY
BREVO_API_KEY=DUMMY_BREVO_API_KEY
